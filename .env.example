# Copy to .env and adjust as needed. Values below work for local Docker Compose.
#
# Ports are deliberately offset from project-enigma's defaults (5432/3001/5173)
# so both projects can run side by side on the same machine.

# PostgreSQL
POSTGRES_USER=fcapp
POSTGRES_PASSWORD=fcapp
POSTGRES_DB=fcapp
# Host port for PostgreSQL (the container listens on 5432 internally).
POSTGRES_PORT=5433

# Connection string for tools running ON THE HOST (local backend dev,
# npm run migrate). Points at the db container's published port.
# Containers build their own in-network URL (db:5432) in docker-compose.yml,
# so this value is only used outside Docker.
DATABASE_URL=postgresql://fcapp:fcapp@localhost:5433/fcapp

# Ports
BACKEND_PORT=4001
FRONTEND_PORT=4173
VITE_PORT=4173

# Frontend → backend base URL
VITE_API_URL=http://localhost:4001

# Auth (issue #3, ADR-004)
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud
# Console and add AUTH_CALLBACK_URL as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_CALLBACK_URL=http://localhost:4001/auth/google/callback
# Where the backend redirects after sign-in, and the allowed CORS origin.
FRONTEND_URL=http://localhost:4173
# Set to true in production behind HTTPS so cookies are marked Secure.
COOKIE_SECURE=false
