# Copy to .env and adjust as needed. Values below work for local Docker Compose.

# PostgreSQL
POSTGRES_USER=fcapp
POSTGRES_PASSWORD=fcapp
POSTGRES_DB=fcapp

# Connection string used by the backend and the migrate service.
# Inside Docker Compose the host is `db`; when running the backend directly
# on your machine, use `localhost` instead.
DATABASE_URL=postgresql://fcapp:fcapp@db:5432/fcapp

# Ports
BACKEND_PORT=3001
FRONTEND_PORT=5173
VITE_PORT=5173

# Frontend → backend base URL
VITE_API_URL=http://localhost:3001
