# Copy to .env and adjust as needed. Values below work for local Docker Compose.

# PostgreSQL
POSTGRES_USER=fcapp
POSTGRES_PASSWORD=fcapp
POSTGRES_DB=fcapp

# Connection string used by the backend and the migrate service.
# Inside Docker Compose the host is `db`; when running the backend directly
# on your machine, use `localhost` instead.
DATABASE_URL=postgresql://fcapp:fcapp@db:5432/fcapp

# Ports
BACKEND_PORT=3001
FRONTEND_PORT=5173
VITE_PORT=5173

# Frontend → backend base URL
VITE_API_URL=http://localhost:3001

# Auth (issue #3, ADR-004)
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud
# Console and add AUTH_CALLBACK_URL as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_CALLBACK_URL=http://localhost:3001/auth/google/callback
# Where the backend redirects after sign-in, and the allowed CORS origin.
FRONTEND_URL=http://localhost:5173
# Set to true in production behind HTTPS so cookies are marked Secure.
COOKIE_SECURE=false
