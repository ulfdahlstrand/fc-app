# Development-only Dockerfile for the backend service.
# No production-optimised build stage is included.

FROM node:20-alpine

WORKDIR /app

# Install curl for health checks and connectivity verification
RUN apk add --no-cache curl

# Copy root workspace configuration files
COPY package.json ./
COPY turbo.json ./
COPY tsconfig.json ./

# Copy package manifests for all workspaces to allow npm install
COPY apps/backend/package.json ./apps/backend/
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/contracts/package.json ./packages/contracts/

# Install all workspace dependencies
RUN npm install

# Build the shared contracts package so its compiled dist/ exists in the image.
# @fc-app/contracts is consumed as a built dependency (its exports point at
# dist/), and — unlike apps/backend — it is not bind-mounted, so it must be
# built here. Editing contracts therefore requires an image rebuild.
COPY packages/tsconfig ./packages/tsconfig
COPY packages/contracts ./packages/contracts
RUN npm run build --workspace @fc-app/contracts

# The apps/backend source directory is bind-mounted at runtime via docker-compose.yml.
# No COPY of source code is needed here — changes are reflected immediately (hot-reload).

WORKDIR /app/apps/backend

EXPOSE ${BACKEND_PORT}

# dev:docker skips --env-file — configuration comes from docker-compose
# (env_file/environment), and no .env exists inside the container.
CMD ["npm", "run", "dev:docker"]
